
###########################################################################
#
#    CDE Application Builder Makefile
#
# This file was generated by `dtcodegen' from project file `ui.bip'.
# The target platform for this Makefile is OpenBSD.
#
###########################################################################

###########################################################################
# These are the OpenBSD-dependent configuration parameters that must be
# set in order for any application to build.
###########################################################################

.KEEP_STATE:

        RM = rm -f
        INCLUDES = -I/usr/dt/include -I/X11/include

        STD_DEFINES = 
        ANSI_DEFINES = 

        CDEBUGFLAGS = -g
        COPTFLAGS = -O2
        SYS_LIBRARIES = -lgen -lm
        CDE_LIBPATH = /usr/dt/lib
        CDE_LDFLAGS = -L$(CDE_LIBPATH)
        ALLX_LIBPATH = /X11/lib
        ALLX_LDFLAGS = -L$(ALLX_LIBPATH)
        LOCAL_LIBRARIES = -lDtWidget -lDtHelp -lDtSvc -lXm -lXt -lXext -lX11 -lICE -lSM -lXp

        CFLAGS = $(CDEBUGFLAGS) $(INCLUDES) $(STD_DEFINES) $(ANSI_DEFINES)
        LDLIBS = $(SYS_LIBRARIES)
        LDOPTIONS = $(CDE_LDFLAGS) $(ALLX_LDFLAGS)

        DTCODEGEN = dtcodegen

###########################################################################
#  These parameters are generated by dtcodegen according to the structure
#  of the project as defined in the .bip and .bil files
###########################################################################

PROGRAM = ui

TARGETS.h = \
	dtb_utils.h \
	main_win_ui.h \
	dilogs_ui.h

TARGETS.c = \
	dtb_utils.c \
	main_win_ui.c \
	dilogs_ui.c

TARGETS.h.merged = \
	ui.h

TARGETS.c.merged = \
	ui.c \
	main_win_stubs.c \
	dilogs_stubs.c

SOURCES.h = $(TARGETS.h.merged) $(TARGETS.h)

SOURCES.c = $(TARGETS.c.merged) $(TARGETS.c)

OBJS = \
	ui.o \
	dtb_utils.o \
	main_win_ui.o \
	main_win_stubs.o \
	dilogs_ui.o \
	dilogs_stubs.o

######################################################################
# Standard targets.                                                  #
######################################################################
all:: $(PROGRAM)

$(PROGRAM) : $(SOURCES.c) $(SOURCES.h) $(OBJS)
	$(RM) $@
	$(CC) -o $@ $(OBJS) $(LDOPTIONS) $(LOCAL_LIBRARIES) $(LDLIBS)

ui.c ui.h dtb_utils.c dtb_utils.h: ui.bip
	$(DTCODEGEN) -changed -merge -p ui.bip -main
ui.o: ui.c ui.bip $(TARGETS.h) $(TARGETS.h.merged)
ui.c: $(TARGETS.h)


main_win_ui.c main_win_ui.h main_win_stubs.c: ui.bip main_win.bil
	$(DTCODEGEN) -changed -merge -p ui.bip main_win
main_win_ui.o: main_win_ui.c main_win_ui.h main_win.bil
main_win_stubs.o: main_win_stubs.c main_win_ui.h main_win.bil

dilogs_ui.c dilogs_ui.h dilogs_stubs.c: ui.bip dilogs.bil
	$(DTCODEGEN) -changed -merge -p ui.bip dilogs
dilogs_ui.o: dilogs_ui.c dilogs_ui.h dilogs.bil
dilogs_stubs.o: dilogs_stubs.c dilogs_ui.h dilogs.bil

CLEAN_FILES =	core .dtcodegen.log *.BAK *.delta \
		$(PROGRAM) $(OBJS) $(TARGETS.c) $(TARGETS.h)
clean:
	$(RM)  $(CLEAN_FILES)

scour:
	$(RM) $(CLEAN_FILES) $(TARGETS.h.merged) $(TARGETS.c.merged) \
	      Makefile Makefile.aix Makefile.sunos \
	      Makefile.linux \
	      Makefile.freebsd Makefile.netbsd Makefile.openbsd
