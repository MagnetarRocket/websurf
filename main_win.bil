:bil-version	1 0
:module main_win
(

:element mainwindow
(
	:type			:base-window
	:width			632
	:height			462
	:bg-color		"white"
	:icon-label		"Websurf"
	:label			"Websurf:"
	:resizable		:true
	:visible		:true
	:iconic			:false
	:children		(
		menubar
		mainwindow_toolbar
		drawpane
		mainwindow_footer
	)
	:win-children		(
		dialog_about
		dialog_bookmarks
		dialog_security
	)
)
:element menubar
(
	:type			:container
	:container-type		:menu-bar
	:active			:true
	:children		(
		menubar_File_item
		menubar_Edit_item
		menubar_View_item
		menubar_Navigate_item
		menubar_Bookmarks_item
		menubar_Options_item
		menubar_Help_item
	)
)
:element menubar_File_item
(
	:type			:item
	:item-type		:item-for-menubar
	:label-type		:string
	:label			"File"
	:is-help-item		:false
	:menu			File_menu
	:active			:true
)
:element menubar_Edit_item
(
	:type			:item
	:item-type		:item-for-menubar
	:label-type		:string
	:label			"Edit"
	:is-help-item		:false
	:menu			Edit_menu
	:active			:true
)
:element menubar_View_item
(
	:type			:item
	:item-type		:item-for-menubar
	:label-type		:string
	:label			"View"
	:is-help-item		:false
	:menu			View_menu
	:active			:true
)
:element menubar_Navigate_item
(
	:type			:item
	:item-type		:item-for-menubar
	:label-type		:string
	:label			"Navigate"
	:is-help-item		:false
	:menu			Navigate_menu
	:active			:true
)
:element menubar_Bookmarks_item
(
	:type			:item
	:item-type		:item-for-menubar
	:label-type		:string
