	:menu			Bookmarks_menu
	:active			:true
)
:element menubar_Options_item
(
	:type			:item
	:item-type		:item-for-menubar
	:label-type		:string
	:label			"Options"
	:is-help-item		:false
	:menu			Options_menu
	:active			:true
)
:element menubar_Help_item
(
	:type			:item
	:item-type		:item-for-menubar
	:label-type		:string
	:label			"Help"
	:is-help-item		:true
	:menu			Help_menu
	:active			:true
)
:element mainwindow_toolbar
(
	:type			:container
	:container-type		:tool-bar
	:height			48
	:visible		:true
	:border-frame		:shadow-out
	:children		(
		button_back
		button_fowards
		location_url
		button_home
		button_refresh
		button_halt
		button_go
	)
)
:element button_back
(
	:type			:button
	:button-type		:push-button
	:x			4
	:y			8
	:label-type		:graphic
	:label-alignment	:center
	:label			"/home/prime/documents/code/websurf/control-backwards"
	:active			:true
	:visible		:true
	:north-attachment	(:point 0 8)
	:west-attachment	(:point 0 4)
)
