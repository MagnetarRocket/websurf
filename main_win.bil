:element drawpane
(
	:type			:drawing-area
	:x			0
	:y			0
	:width			637
	:height			463
	:drawarea-width		635
	:drawarea-height	461
	:bg-color		"white"
	:border-frame		:none
	:hscrollbar		:when-needed
	:vscrollbar		:when-needed
	:active			:true
	:visible		:true
	:north-attachment	(:point 0 0)
	:south-attachment	(:obj mainwindow -1)
	:east-attachment	(:obj mainwindow -1)
	:west-attachment	(:point 0 0)
)
:element mainwindow_footer
(
	:type			:container
	:container-type		:footer
	:height			28
	:visible		:true
	:border-frame		:none
	:children		(
		mainwindow_label
		gauge_load
	)
)
:element mainwindow_label
(
	:type			:label
	:x			1
	:y			1
	:label-type		:string
	:label			"footer message"
	:label-alignment	:left
	:active			:true
	:visible		:true
	:north-attachment	(:point 0 1)
	:west-attachment	(:point 0 1)
)
:element gauge_load
(
	:type			:scale
	:label-type		:string
	:label			"Progress:"
	:label-position		:west
	:read-only		:true
	:orientation		:horizontal
	:direction		:left-to-right
	:min-value		0
	:max-value		100
	:initial-value		50
	:increment		1
	:decimal-points		0
	:show-value		:false
	:x			468
	:y			0
	:width			102
	:height			20
	:active			:true
	:visible		:true
	:north-attachment	(:point 0 0)
	:east-attachment	(:point 0 0)
	:west-attachment	(:obj-edge mainwindow_footer -167)
)
:element dialog_about
(
	:type			:dialog
	:width			380
	:height			175
	:bg-color		"white"
	:label			"About websurf"
	:resizable		:false
	:visible		:false
	:default-button		about_dialog_button1
	:children		(
		controlpane
		dialog_button_panel
	)
)
:element controlpane
(
	:type			:container
	:container-type		:relative
	:x			0
	:y			0
	:width			380
	:height			175
	:visible		:true
	:border-frame		:none
	:north-attachment	(:point 0 0)
	:south-attachment	(:obj dialog_about 0)
	:east-attachment	(:obj dialog_about 0)
	:west-attachment	(:point 0 0)
	:children		(
		label
	)
)
