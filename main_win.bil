:element file_seln
(
	:type			:file-chooser
	:visible		:false
	:label			"Open file"
	:filter-pattern		"*.html *.htl"
	:ok-label		"Open"
	:auto-dismiss		:true
	:directory		"~"
	:file-type-mask		:regular
)
:element file_seln_saveas
(
	:type			:file-chooser
	:visible		:false
	:label			"Save as..."
	:ok-label		"Ok"
	:auto-dismiss		:true
	:file-type-mask		:directory
)
:connection
(
	:from			File_menu_Open_item
	:to			file_seln
	:when			:activate
	:action-type		:builtin
	:action			:show
	:arg-type		:void
)
:connection
(
	:from			file_seln
	:to			file_seln
	:when			:ok
	:action-type		:builtin
	:action			:hide
	:arg-type		:void
)
:connection
(
	:from			file_seln
	:to			file_seln
	:when			:cancel
	:action-type		:builtin
	:action			:hide
	:arg-type		:void
)
:connection
(
	:from			Help_menu_About_item
	:to			dialog_about
	:when			:activate
	:action-type		:builtin
	:action			:show
	:arg-type		:void
)
